generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String        @id @default(uuid())
  nombre        String
  email         String        @unique
  password      String
  role          Role          @default(USER)
  suscripciones Suscripcion[]
  createdAt     DateTime      @default(now())
}

model Escuderia {
  id          String   @id @default(uuid())
  nombre      String
  puntos2025  Int
  fundacion   Int
  base        String
  campeonatos Int
  color       String
  categoria   String
  imagenLogo  String?
  historia    String?  @db.Text
  pilotos     Piloto[]
}

model Piloto {
  id              String   @id @default(uuid())
  nombre          String
  numero          Int
  escuderiaId     String
  escuderia       Escuderia @relation(fields: [escuderiaId], references: [id], onDelete: Cascade)
  nacionalidad    String?
  fechaNacimiento String?
  lugarNacimiento String?
  biografia       String?  @db.Text
  carreras        Int      @default(0)
  victorias       Int      @default(0)
  podios          Int      @default(0)
  poles           Int      @default(0)
  vueltasRapidas  Int      @default(0)
  puntos          Int      @default(0)
  logros          String?  @db.Text
  imagenPerfil    String?
}

model Suscripcion {
  id            String   @id @default(uuid())
  userId        String
  mensaje       String
  fechaCreacion DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}